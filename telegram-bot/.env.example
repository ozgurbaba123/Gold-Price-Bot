# Telegram BotFather'dan alınan token
BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Otomatik fiyat gönderilecek sohbet ID'leri (virgülle ayırın)
# /start komutunu yazınca Chat ID'nizi öğrenebilirsiniz
CHAT_IDS=-1001234567890,-987654321

# Kaç dakikada bir otomatik fiyat gönderilsin (varsayılan: 30)
INTERVAL_MINUTES=30

# Saat dilimi (varsayılan: Europe/Istanbul)
TIMEZONE=Europe/Istanbul
